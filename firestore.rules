// ─────────────────────────────────────────────────────────────────────────
// HakbangHero — Firestore rules WITH ECONOMY GUARD.
// GENERATED by tools/gen_economy_rules.py — do not edit by hand; edit the
// generator or your Dart data and run it again.
//
// TEST BEFORE PUBLISHING: Firebase Console > Firestore > Rules > Rules
// Playground, or the emulator. Keep your old rules copied somewhere so you
// can roll back in one click.
// ─────────────────────────────────────────────────────────────────────────
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMe(uid)  { return signedIn() && request.auth.uid == uid; }

    // TESTER accounts: listed by hand in the Firebase console
    // (Firestore > testers > document id = the player's UID). Only checked
    // when the normal economy check fails, so normal players pay nothing.
    function isTester() {
      return signedIn()
        && exists(/databases/$(database)/documents/testers/$(request.auth.uid));
    }

    // ── catalog (generated from hero_items.dart / hero_roster.dart) ──
    // Unknown ids cost 999999999, so they can never be "bought".
    // ONE map of item prices. Build it once per request (with `let`): Firestore
    // stops a request after 1,000 evaluated expressions, and building this
    // ~100-item map seven times went over that, so every item purchase was
    // refused. (No empty-text keys: Firestore refuses them.)
    function itemPrices() { return {'cap_red': 0, 'beanie_blue': 0, 'ears_cat': 120, 'wizard_hat': 0, 'helm_knight': 0, 'halo': 400, 'crown_gold': 0, 'sweatband': 60, 'bucket_hat': 150, 'beret': 180, 'tophat': 350, 'viking': 500, 'pirate_hat': 800, 'crown_ice': 1200, 'crown_royal': 2800, 'stache': 60, 'glasses_round': 80, 'shades': 150, 'mask_hero': 0, 'freckles': 50, 'blush': 60, 'bandage': 70, 'glasses_nerd': 120, 'goggles_swim': 160, 'eyepatch': 280, 'beard': 350, 'visor_cyber': 500, 'shades_star': 700, 'mask_masq': 1000, 'shades_diamond': 2200, 'tee_stripes': 100, 'hoodie_orange': 0, 'jersey_bolt': 200, 'gi_ninja': 350, 'armor_silver': 0, 'armor_gold': 0, 'tee_lime': 80, 'polo_navy': 140, 'tank_sport': 180, 'flannel': 300, 'varsity': 450, 'track_retro': 500, 'robe_star': 900, 'armor_crystal': 1200, 'armor_dragon': 2500, 'shorts_red': 0, 'pants_track': 120, 'pants_camo': 250, 'shorts_gold': 0, 'shorts_denim': 70, 'shorts_gym': 90, 'jeans': 150, 'pants_khaki': 180, 'joggers': 280, 'shorts_board': 320, 'pants_plaid': 450, 'hakama': 750, 'leggings_galaxy': 1100, 'greaves': 1300, 'pants_royal': 2200, 'sneak_red': 0, 'runners_neon': 0, 'boots_gold': 450, 'wing_shoes': 600, 'rocket_boots': 0, 'slides': 60, 'sneak_blue': 70, 'sneak_white': 100, 'hightops': 180, 'boots_hiking': 300, 'cleats': 400, 'sneak_flame': 550, 'boots_frost': 900, 'sneak_galaxy': 1200, 'boots_dragon': 2400, 'cape_red': 0, 'backpack': 130, 'wings_bat': 0, 'wings_angel': 800, 'sling_bag': 90, 'backpack_school': 150, 'quiver': 200, 'cape_night': 300, 'surfboard': 380, 'wings_butterfly': 550, 'shield_round': 750, 'wings_fairy': 900, 'jetpack': 1100, 'cape_royal': 2000, 'scarf_red': 0, 'medal_gold': 0, 'belt_champ': 0, 'tie_red': 60, 'bowtie': 80, 'bandana': 100, 'whistle': 120, 'scarf_cozy': 150, 'dogtags': 250, 'neckphones': 380, 'pearls': 450, 'chain_gold': 700, 'amulet': 1000, 'medallion': 1300, 'collar_diamond': 2500, 'wavy_mane': 0, 'neutral': 0, 'outfit_01_default_starter_set': 0}; }
    function heroCoins(id) { return {'sprout': 0, 'frog': 0, 'penguin': 0, 'slime': 0, 'bear': 300, 'cat': 300, 'fox': 400, 'panda': 400, 'dino': 500, 'ghost': 0, 'shroom': 0, 'pirate': 0, 'ninja': 0, 'knight': 0, 'astronaut': 0, 'wizard': 1000, 'mech': 1200, 'dragon': 1500, 'alien': 0, 'flame': 0}.get(id, 999999999); }
    // earned heroes that need a cleared rank: hero id -> stage id
    function heroStage(id) { return {'ninja': 'stage_novice', 'knight': 'stage_vanguard', 'flame': 'stage_slayer'}.get(id, ''); }
    // heroes with a level requirement: hero id -> total XP that level needs
    function heroMinXp(id) { return {'ghost': 1500, 'pirate': 5000, 'wizard': 7500, 'mech': 14000}.get(id, 0); }
    // rank / trial targets: mode id -> [km, seconds]
    function stageTarget(mode) { return {'stage_novice': [2, 1200], 'stage_vanguard': [3.5, 1800], 'stage_slayer': [5, 2400], 'trial_2k_15': [2, 900], 'trial_2k_12': [2, 720], 'trial_2k_10': [2, 600], 'trial_5k_40': [5, 2400], 'trial_5k_32': [5, 1920], 'trial_5k_27': [5, 1620], 'trial_10k_80': [10, 4800], 'trial_10k_65': [10, 3900], 'trial_10k_55': [10, 3300], 'trial_42k_390': [42.195, 23400], 'trial_42k_330': [42.195, 19800], 'trial_42k_270': [42.195, 16200]}.get(mode, [999999999, 0]); }

    // ── helpers over the user document ──
    function od(f, d) { return resource.data.get(f, d); }
    function nd(f, d) { return request.resource.data.get(f, d); }
    function changed(f) { return nd(f, null) != od(f, null); }
    function delta(f) { return nd(f, 0) - od(f, 0); }
    function epoch() { return timestamp.date(2000, 1, 1); }

    function actPath(uid, id) {
      return /databases/$(database)/documents/users/$(uid)/activities/$(id);
    }

    // ── a RUN (or duel) commit: reward must be justified by a new run record ──
    function runCommit() {
      return changed('last_run_id')
        && nd('last_run_id', '') is string
        && nd('last_run_id', '').size() > 0;
    }

    // Daily coin cap for runs/duels: the app keeps coins_today (+ the day
    // number, Manila time) and the rules make that counter honest.
    function coinDay() { return math.floor(float(request.time.toMillis() + 28800000) / 86400000.0); }
    function dailyCoinsOk() {
      return delta('coins') == 0
        || (nd('coins_today_day', -1) == coinDay()
            && nd('coins_today', 0)
               == (od('coins_today_day', -1) == coinDay() ? od('coins_today', 0) : 0)
                  + delta('coins')
            && nd('coins_today', 0) <= 12000);
    }

    function runAmountsOk(a) {
      // coins = the run's own coins + bonuses (daily quests, rank clears and
      // stars, challenges, ghost win). 1 crystal used to be worth 10 coins.
      return delta('coins') >= 0
        && dailyCoinsOk()
        && delta('coins') <= a.coinsEarned + (a.distanceKm > 0 ? 1500 : 0) + 300 * a.distanceKm
                             + (changed('stage_records') ? 3000 : 0)
        && delta('xp') >= 0 && delta('xp') <= a.xpEarned
        && delta('total_km') >= 0 && delta('total_km') <= a.distanceKm + 0.001
        && delta('total_sessions') == 1
        && delta('loot_chests') >= 0 && delta('loot_chests') <= 3
        // runs never overlap in time: each one starts after the last one
        // ended (2 min slack), and none ends in the future
        && nd('last_run_end', null) == a.endTime
        && a.startTime >= od('last_run_end', epoch()) - duration.value(120, 's')
        && a.endTime >= a.startTime
        && a.endTime <= request.time + duration.value(600, 's');
    }

    function runOk(uid) {
      return runCommit()
        && existsAfter(actPath(uid, nd('last_run_id', '')))
        && !exists(actPath(uid, nd('last_run_id', '')))
        && runAmountsOk(getAfter(actPath(uid, nd('last_run_id', ''))).data);
    }

    // stage_records may change only for the mode of THIS run, and only if the
    // run record really cleared it (target distance inside the clock).
    function stageProof(a) {
      return a.get('stage_result', '') == 'STAGE CLEARED!'
        && request.resource.data.stage_records
             .diff(resource.data.get('stage_records', {}))
             .affectedKeys().hasOnly([a.mode])
        && a.distanceKm >= stageTarget(a.mode)[0] - 0.01
        && a.durationSeconds <= stageTarget(a.mode)[1] + 2;
    }

    // (runOk itself is enforced by economyOk whenever a run is committed)
    function stageOk(uid) {
      return !changed('stage_records')
        || (runChange() && runCommit()
            && stageProof(getAfter(actPath(uid, nd('last_run_id', ''))).data));
    }

    // ── duel prize: only the winner of a challenge that just finished ──
    // Only looks the challenge up when this write really claims a duel (a
    // lookup of an empty id would make every other coin claim fail).
    function duelWinOk(uid) {
      return changed('last_duel_id')
        && nd('last_duel_id', '') is string
        && nd('last_duel_id', '').size() > 0
        && duelPrizeOk(uid,
             /databases/$(database)/documents/challenges/$(nd('last_duel_id', '')));
    }
    function duelPrizeOk(uid, path) {
      let c = getAfter(path).data;
      return c.winner == uid
        && validatedDuel(c)
        && get(path).data.status != 'done'
        // a win by default pays only the share of the distance actually run
        // (the rules language has no min(): written as a comparison)
        && delta('coins') <= c.reward * (c.progress[uid] >= c.distance_km
                                           ? 1.0 : c.progress[uid] / c.distance_km)
        && delta('coins') <= c.get('prize', 0)
        && dailyCoinsOk()
        // at most 3 paid duel wins per day (Manila day)
        && nd('duel_prize_day', -1) == coinDay()
        && nd('duel_prizes_today', 0)
             == (od('duel_prize_day', -1) == coinDay() ? od('duel_prizes_today', 0) : 0) + 1
        && nd('duel_prizes_today', 0) <= 3;
    }

    // ── daily streak and weekly goal gifts ──
    function streakOk() {
      return nd('streak_claims', []).size() == od('streak_claims', []).size() + 1
        && nd('streak_claims', []).hasAll(od('streak_claims', []))
        && nd('streak_claim_at', null) == request.time
        && request.time > od('streak_claim_at', epoch()) + duration.value(12, 'h')
        && delta('coins') <= 4000;
    }

    // calendar week number, weeks start Monday (Manila time)
    function weekIdx() { return math.floor(float(coinDay() + 3) / 7.0); }
    function weeklyOk() {
      return changed('weekly_goal_claimed')
        && nd('weekly_claim_week', -1) == weekIdx()
        && od('weekly_claim_week', -1) != weekIdx()
        && delta('coins') <= 500;
    }

    // ── shop: every new item / hero must be paid at (at least) catalog price ──
    // arrayUnion appends, so the NEW entries are the tail of the new array.
    // weekly pick is 25% off: pay at least 75% of the price
    function minPay(v) { return math.floor(v * 0.75); }

    // Price of the (up to 7) NEW items at the tail of the list. The price
    // map is built ONCE (let) and each slot is read only if it exists.
    function itemCoinsMin(ni, k) {
      let m = itemPrices();
      return minPay(k < ni.size() ? m.get(ni[k], 999999999) : 0)
           + minPay(k + 1 < ni.size() ? m.get(ni[k + 1], 999999999) : 0)
           + minPay(k + 2 < ni.size() ? m.get(ni[k + 2], 999999999) : 0)
           + minPay(k + 3 < ni.size() ? m.get(ni[k + 3], 999999999) : 0)
           + minPay(k + 4 < ni.size() ? m.get(ni[k + 4], 999999999) : 0)
           + minPay(k + 5 < ni.size() ? m.get(ni[k + 5], 999999999) : 0)
           + minPay(k + 6 < ni.size() ? m.get(ni[k + 6], 999999999) : 0);
    }
    function heroCoinsMin(nh, k) { return k < nh.size() ? heroCoins(nh[k]) : 0; }
    function heroUnlockedByRank(nh, k) {
      return k >= nh.size()
        || ((heroStage(nh[k]) == ''
             || nd('stage_records', {}).get(heroStage(nh[k]), {}).get('stars', 0) > 0)
            && nd('xp', 0) >= heroMinXp(nh[k]));
    }

    function ownershipOk() {
      return nd('owned_items', []).hasAll(od('owned_items', []))
        && nd('owned_heroes', []).hasAll(od('owned_heroes', []))
        && nd('owned_items', []).size() <= od('owned_items', []).size() + 7
        && nd('owned_heroes', []).size() <= od('owned_heroes', []).size() + 1
        && od('coins', 0) - nd('coins', 0)
             >= itemCoinsMin(nd('owned_items', []), od('owned_items', []).size())
                + heroCoinsMin(nd('owned_heroes', []), od('owned_heroes', []).size())
        && heroUnlockedByRank(nd('owned_heroes', []), od('owned_heroes', []).size());
    }

    function ownershipNeedsCheck() {
      return nd('owned_items', []).size() > od('owned_items', []).size()
          || nd('owned_heroes', []).size() > od('owned_heroes', []).size();
    }

    // weight / height only change at the weekly check-in (6-day tolerance),
    // and the first time they are set (old value missing)
    function checkInOk() {
      return !changed('body_tier')
        || od('body_tier', null) == null
        || (request.time - od('last_checkin_at', request.time - duration.value(30, 'd')))
             >= duration.value(6, 'd');
    }

    // email / height / weight live in users/{uid}/private (owner only). On the
    // public doc they may only be removed (one-time move of old accounts).
    function noPrivateFields() {
      return (!changed('email') || nd('email', null) == null)
        && (!changed('height_cm') || nd('height_cm', null) == null)
        && (!changed('weight_kg') || nd('weight_kg', null) == null);
    }

    // one-time cash-in of an old crystal balance: 1 crystal = 10 coins
    function migrateOk() {
      return od('gems', 0) > 0 && nd('gems', 0) == 0
        && delta('coins') >= 0 && delta('coins') <= od('gems', 0) * 10;
    }

    // ── put it together ──
    // xp / km / runs / chests only ever go up through a run commit.
    function runChange() {
      return delta('xp') > 0 || delta('total_km') > 0
        || delta('total_sessions') > 0 || delta('loot_chests') > 0;
    }

    function economyOk(uid) {
      return
        checkInOk() && noPrivateFields() &&
        // A run is verified ONCE (its coins are checked inside runOk).
        // Rules may only make ~10 document lookups per write: checking the
        // run separately for coins, xp, km and runs went over that limit and
        // every real run was refused with permission-denied.
        // Without a run, coins can always be SPENT, but only a duel / claim
        // adds them.
        (runChange()
            ? runOk(uid)
            : (delta('coins') <= 0 || streakOk() || weeklyOk()
                || migrateOk() || duelWinOk(uid)))
        // crystals no longer exist: the old balance can only be cashed in
        && delta('gems') <= 0
        && nd('coins', 0) >= 0
        // nobody lowers their own totals to dodge checks
        && delta('xp') >= 0 && delta('total_km') >= 0 && delta('total_sessions') >= 0
        && stageOk(uid)
        // the duel-prize counter only moves with a real duel win
        && ((!changed('duel_prizes_today') && !changed('duel_prize_day'))
            || duelWinOk(uid))
        && (!ownershipNeedsCheck() || ownershipOk())
        && nd('owned_items', []).hasAll(od('owned_items', []))
        && nd('owned_heroes', []).hasAll(od('owned_heroes', []));
    }

    // Picking / switching the hero touches ONLY hero_id and owned_heroes, and
    // may add at most one FREE hero (price 0). This small check runs on its own
    // so choosing a hero never depends on the long economy check below.
    function heroSwitchOk() {
      return request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['hero_id', 'owned_heroes'])
        && nd('hero_id', '') is string
        && nd('owned_heroes', []).hasAll(od('owned_heroes', []))
        && nd('owned_heroes', []).size() <= od('owned_heroes', []).size() + 1
        && (nd('owned_heroes', []).size() == od('owned_heroes', []).size()
            || (heroCoins(nd('owned_heroes', [])[od('owned_heroes', []).size()]) == 0
                && heroUnlockedByRank(nd('owned_heroes', []), od('owned_heroes', []).size())));
    }

    // CHARACTER CREATION ("BEGIN YOUR JOURNEY"): the hero is set up once.
    // Kept separate and simple so it never depends on the economy check:
    // no coins / XP / km / runs / ranks change, the hero is a free starter,
    // and any new items are free.
    function creationOk() {
      return od('character_created', true) == false
        && nd('coins', 0) == od('coins', 0)
        && nd('xp', 0) == od('xp', 0)
        && nd('total_km', 0) == od('total_km', 0)
        && nd('total_sessions', 0) == od('total_sessions', 0)
        && nd('gems', 0) == od('gems', 0)
        && !changed('stage_records')
        && noPrivateFields()
        && nd('owned_heroes', []).hasAll(od('owned_heroes', []))
        && nd('owned_heroes', []).size() <= od('owned_heroes', []).size() + 1
        && (nd('owned_heroes', []).size() == od('owned_heroes', []).size()
            || (heroCoins(nd('owned_heroes', [])[od('owned_heroes', []).size()]) == 0
                && heroStage(nd('owned_heroes', [])[od('owned_heroes', []).size()]) == ''
                && heroMinXp(nd('owned_heroes', [])[od('owned_heroes', []).size()]) == 0))
        && nd('owned_items', []).hasAll(od('owned_items', []))
        && nd('owned_items', []).size() <= od('owned_items', []).size() + 3
        && itemCoinsMin(nd('owned_items', []), od('owned_items', []).size()) == 0;
    }

    // ── SHORT, DEDICATED CHECKS for everyday saves ──
    // Each one names exactly which fields the save may touch (affectedKeys)
    // and checks only those, so these saves never depend on the long
    // economy check (runs, duels, ranks) above.
    function keys() { return request.resource.data.diff(resource.data).affectedKeys(); }

    // Fields with no coin / XP / rank value: outfit, hero choice, "seen"
    // badges, tutorial flags, gender, username key, blocked list.
    function cosmeticOk() {
      return keys().hasOnly(['hero_outfit', 'hero_id', 'stage_seen', 'tutorial_done',
                             'has_completed_first_run_tutorial', 'gender',
                             'username_key', 'blocked_uids']);
    }

    // SHOP: buy items and / or one hero, pay at least the catalog price
    // (weekly pick: 75%), and wear them. Nothing else may change.
    function purchaseOk() {
      return keys().hasOnly(['coins', 'owned_items', 'owned_heroes', 'hero_id', 'hero_outfit'])
        && nd('coins', 0) >= 0
        && delta('coins') <= 0
        && ownershipOk();
    }

    // DAILY STREAK GIFT (once per 12 h) and WEEKLY GOAL GIFT (once a week)
    function streakClaimOk() {
      return keys().hasOnly(['coins', 'streak_claims', 'streak_claim_at'])
        && delta('coins') >= 0
        && streakOk();
    }
    function weeklyClaimOk() {
      return keys().hasOnly(['coins', 'weekly_goal_claimed', 'weekly_claim_at',
                             'weekly_claim_week', 'weekly_goal_log'])
        && delta('coins') >= 0
        && weeklyOk();
    }

    // WEEKLY BODY CHECK-IN (form + endurance bonus, +10 per evolution)
    function checkInSaveOk() {
      return keys().hasOnly(['body_tier', 'best_composition_rank', 'last_checkin_at',
                             'endurance_bonus'])
        && nd('last_checkin_at', null) == request.time
        && checkInOk()
        && delta('endurance_bonus') >= 0 && delta('endurance_bonus') <= 10;
    }

    // old crystals cashed in once (1 crystal = 10 coins)
    function migrateSaveOk() {
      return keys().hasOnly(['coins', 'gems']) && migrateOk();
    }

    function everydayOk() {
      return cosmeticOk() || purchaseOk() || streakClaimOk() || weeklyClaimOk()
        || checkInSaveOk() || migrateSaveOk();
    }

    // a new account starts with the sign-up gift only
    function freshAccount() {
      return nd('coins', 0) <= 100 && nd('gems', 0) == 0
        && nd('xp', 0) == 0 && nd('total_km', 0) == 0
        && nd('total_sessions', 0) == 0
        && nd('owned_items', []).size() <= 12
        && nd('email', null) == null && nd('weight_kg', null) == null
        && nd('height_cm', null) == null;
    }

    // a run record must be humanly possible and its reward must fit the formula
    // (utils/rewards.dart: 100 xp/km + 3 xp/min, x1.3 pace, x3.5 mode, + events)
    function activityOk(a) {
      return a.distanceKm is number && a.distanceKm >= 0
        && a.durationSeconds is int && a.durationSeconds >= 0
        && a.durationSeconds <= 172800
        && a.distanceKm <= a.durationSeconds / 3600.0 * 25 + 0.05
        && a.coinsEarned is int && a.coinsEarned >= 0
        && a.coinsEarned <= a.distanceKm * 10 * 3.5 + 1
        && a.xpEarned is int && a.xpEarned >= 0
        // moving time can't be longer than the distance walked at 1.5 km/h
        // (+2 min), so standing still earns no time XP
        && a.xpEarned <= (a.distanceKm * 100
             + (a.durationSeconds < a.distanceKm / 1.5 * 3600 + 120
                  ? a.durationSeconds : a.distanceKm / 1.5 * 3600 + 120) / 60.0 * 5)
             * 1.3 * 3.5 + 300;
    }

    // ── private body data (height / weight) ──
    function userDoc(uid) { return /databases/$(database)/documents/users/$(uid); }
    function bodyRangesOk() {
      return (request.resource.data.get('weight_kg', null) == null
              || (request.resource.data.weight_kg is number
                  && request.resource.data.weight_kg >= 20
                  && request.resource.data.weight_kg <= 400))
        && (request.resource.data.get('height_cm', null) == null
              || (request.resource.data.height_cm is number
                  && request.resource.data.height_cm >= 50
                  && request.resource.data.height_cm <= 260));
    }
    function privBodyChanged() {
      return request.resource.data.get('weight_kg', null) != resource.data.get('weight_kg', null)
        || request.resource.data.get('height_cm', null) != resource.data.get('height_cm', null);
    }
    // this write is a weekly check-in: the public doc gets last_checkin_at =
    // now in the same batch, and the previous one is 6+ days old
    // the hero is still being created (first values, or a retry after a
    // failed attempt): height / weight may be set freely
    function stillCreating(uid) {
      return get(userDoc(uid)).data.get('character_created', true) == false;
    }
    function consentOk() {
      return request.resource.data.keys().hasOnly(['terms_version', 'privacy_version', 'accepted_at'])
        && request.resource.data.terms_version == '1.0' && request.resource.data.privacy_version == '1.0'
        && request.resource.data.accepted_at == request.time;
    }
    // Finished runs never change inventory or profile fields. Keep them out of
    // the shop/catalog alternatives, which exceed the rule expression budget.
    function runSaveOk(uid) {
      return keys().hasOnly(['total_km', 'total_sessions', 'last_run_id', 'last_run_end', 'badge_stats',
          'xp', 'coins', 'coins_today', 'coins_today_day', 'loot_chests', 'daily_progress_km',
          'daily_progress_date', 'daily_quests_claimed', 'last_run_at', 'week_key', 'week_km',
          'month_key', 'month_km', 'stage_records', 'interval_runs', 'interval_best_rounds', 'interval_best_fast_pace_s'])
        && nd('coins', 0) >= 0 && runOk(uid) && stageOk(uid);
    }
    function duelRewardSaveOk(uid) {
      return keys().hasOnly(['coins', 'coins_today', 'coins_today_day', 'duel_prize_day',
          'duel_prizes_today', 'last_duel_id']) && delta('coins') > 0 && duelWinOk(uid);
    }
    // one-time move of an old account's height / weight off the public doc
    function movedFromPublic(uid) {
      return 'weight_kg' in get(userDoc(uid)).data
        && request.resource.data.get('weight_kg', null) == get(userDoc(uid)).data.weight_kg
        && request.resource.data.get('height_cm', null)
             == get(userDoc(uid)).data.get('height_cm', null);
    }
    function checkInNow(uid) {
      return getAfter(userDoc(uid)).data.get('last_checkin_at', null) == request.time
        && request.time >= get(userDoc(uid)).data.get('last_checkin_at', timestamp.date(2000, 1, 1))
                            + duration.value(6, 'd');
    }

    // ── users ──
    match /users/{uid} {
      allow read: if signedIn();                 // leaderboard + friend profiles
      allow create: if isMe(uid) && freshAccount();
      allow update: if isMe(uid) && duelUserGuard(uid)
        && (runCommit() ? runSaveOk(uid) : changed('last_duel_id') ? duelRewardSaveOk(uid)
          : (heroSwitchOk() || creationOk() || everydayOk() || isTester() || economyOk(uid)));
      allow delete: if isMe(uid);

      // email / height / weight: only the player can read or write them.
      // Height / weight change only at the weekly check-in: the same batch
      // must stamp last_checkin_at on the public doc, 6+ days after the last
      // one (the app asks every 7 days). First values are always allowed.
      match /private/{doc} {
        allow read, delete: if isMe(uid);
        allow create: if isMe(uid) && (doc != 'consent' || consentOk()) && bodyRangesOk()
          && ((request.resource.data.get('weight_kg', null) == null
                && request.resource.data.get('height_cm', null) == null)
              || !('last_checkin_at' in get(userDoc(uid)).data)
              || stillCreating(uid)
              || movedFromPublic(uid)
              || checkInNow(uid));
        allow update: if isMe(uid) && (doc != 'consent' || consentOk()) && bodyRangesOk()
          && (!privBodyChanged()
              || resource.data.get('weight_kg', null) == null
              || stillCreating(uid)
              || movedFromPublic(uid)
              || checkInNow(uid));
      }

      // weekly weight history (profile chart)
      match /weight_checkins/{id} {
        allow read: if isMe(uid);
        allow create: if isMe(uid)
          && request.resource.data.weight_kg is number
          && request.resource.data.weight_kg >= 20
          && request.resource.data.weight_kg <= 400;
        allow update, delete: if false;
      }

      match /activities/{id} {
        allow read: if isMe(uid);
        // testers may add history-only practice runs (TESTER TOOLS > streak)
        allow create: if isMe(uid)
          && duelRunOk(uid, id, request.resource.data)
          && (activityOk(request.resource.data) || isTester());
        allow update: if false;
        allow delete: if isMe(uid);
      }

      // Finished runs waiting to be counted. Uploaded the moment a run ends
      // (works on any device / weak signal), then counted by the normal,
      // fully checked run save and deleted. Gives no rewards by itself.
      match /pending_runs/{id} {
        allow read, delete: if isMe(uid);
        allow create: if isMe(uid) && request.resource.data.uid == uid;
        allow update: if false;
      }

      // Friendship is stored on BOTH players. The accepting player may write
      // the other side only while a pending request from them exists.
      match /friends/{fid} {
        allow read: if isMe(uid);
        // Both sides are written by the player who ACCEPTS a pending request,
        // so nobody can add a friend without the other player's consent.
        allow create: if (isMe(uid)
              && exists(/databases/$(database)/documents/friend_requests/$(fid + '_' + uid))
              && get(/databases/$(database)/documents/friend_requests/$(fid + '_' + uid)).data.status == 'pending')
          || (isMe(fid)
              && exists(/databases/$(database)/documents/friend_requests/$(uid + '_' + fid))
              && get(/databases/$(database)/documents/friend_requests/$(uid + '_' + fid)).data.status == 'pending');
        allow update: if isMe(uid);
        allow delete: if isMe(uid) || isMe(fid);   // unfriend removes both sides
      }
    }

    // ── tester list: each player may only ask "am I a tester?". Nobody can
    //    write it from the app; add / remove testers in the Firebase console.
    match /testers/{tid} {
      allow get: if isMe(tid);
      allow list, create, update, delete: if false;
    }

    // ── friend codes: lookup only, never listable ──
    match /friend_codes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid; // account deletion
    }

    // ── usernames: one player per name (id = name in lower case) ──
    match /usernames/{name} {
      allow get: if true;            // "is this name taken?" before sign-up
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && name.size() > 0 && name.size() <= 40;
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // ── online / idle / offline dot: a tiny doc per player ──
    match /presence/{uid} {
      allow read: if signedIn();
      allow create, update: if isMe(uid)
        && request.resource.data.keys().hasOnly(['presence', 'presence_at'])
        && request.resource.data.presence in ['online', 'idle', 'offline']
        && stamped(request.resource.data, 'presence_at');
      allow delete: if isMe(uid);
    }

    // ── friend requests: doc id = "{fromUid}_{toUid}" ──
    match /friend_requests/{rid} {
      allow get: if signedIn()
        && (resource == null
            || resource.data.from == request.auth.uid
            || resource.data.to == request.auth.uid);
      allow list: if signedIn()
        && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.from == request.auth.uid
        && rid == request.auth.uid + '_' + request.resource.data.to;
      allow update: if signedIn()
        && (resource.data.to == request.auth.uid                 // accept / decline
            || (resource.data.from == request.auth.uid           // re-send after unfriend
                && request.resource.data.from == request.auth.uid
                && request.resource.data.status == 'pending'
                // after a "no", wait 24 hours before asking again
                && (resource.data.status != 'declined'
                    || request.time > resource.data.get('declined_at', timestamp.date(2000, 1, 1))
                                      + duration.value(24, 'h'))));
      // the receiver can always delete; the sender only while it is not a
      // fresh "no" (deleting it would skip the 24 h wait)
      allow delete: if signedIn()
        && (resource.data.to == request.auth.uid
            || (resource.data.from == request.auth.uid
                && resource.data.status != 'declined'));
    }

    // ── LIVE friend duels ──
    function otherOf(d) {
      return d.participants[0] == request.auth.uid ? d.participants[1] : d.participants[0];
    }
    function myProg(d) { return d.get('progress', {}).get(request.auth.uid, 0); }
    function ownKeyOnly(field) {
      return request.resource.data.get(field, {}).diff(resource.data.get(field, {}))
        .affectedKeys().hasOnly([request.auth.uid]);
    }
    function activityPath(uid) { return /databases/$(database)/documents/player_activity/$(uid); }
    function challengePath(id) { return /databases/$(database)/documents/challenges/$(id); }
    function cooldownPath(a, b) { return /databases/$(database)/documents/duel_cooldowns/$(a)/recipients/$(b); }
    function stamped(d, field) { return d.get(field, null) is timestamp && d[field] == request.time; }
    function freshPresence(uid) {
      let p = get(/databases/$(database)/documents/presence/$(uid)).data;
      return p.presence == 'online' && p.presence_at is timestamp && p.presence_at <= request.time
        && request.time < p.presence_at + duration.value(150, 's');
    }
    function freshPlayers(d) { return freshPresence(d.from) && freshPresence(d.to); }
    function duelReserved(d, id) {
      let a = get(activityPath(d.from)).data;
      let b = get(activityPath(d.to)).data;
      return a.kind == 'duel' && b.kind == 'duel' && a.challenge_id == id && b.challenge_id == id;
    }
    function terminal(d) { return d.status in ['done', 'invalid', 'declined', 'cancelled', 'expired', 'busy', 'unverified']; }
    function pendingLive(d) {
      return d.status == 'pending' && request.time < d.created_at + duration.value(60, 's')
        && (d.get('delivered_at', null) != null || request.time < d.created_at + duration.value(10, 's'));
    }
    function roomLive(d) {
      return d.status == 'lobby' && request.time < d.accepted_at + duration.value(900, 's');
    }
    function validationLive(d) {
      return d.status == 'validating' && request.time < d.validating_at + duration.value(90, 's');
    }
    function fastWindow(w) {
      return w is map && w.seconds is number && w.seconds >= 10
        && w.fixes is int && w.fixes >= 3 && w.gap is number
        && w.gap >= 0 && w.gap <= 5
        && w.speed is number && w.speed > 40;
    }
    function jump(j) {
      return j is map && j.seconds is number && j.seconds >= 1
        && j.seconds <= 5 && j.meters is number && j.meters > 200
        && j.meters / j.seconds * 3.6 > 100 && j.at is number;
    }
    function fastEvidence(report) {
      return report.get('windows', []) is list && report.get('windows', []).size() == 3
        ? fastWindow(report.windows[0]) && fastWindow(report.windows[1]) && fastWindow(report.windows[2]) : false;
    }
    function jumpEvidence(report) {
      return report.get('jumps', []) is list && report.get('jumps', []).size() == 3
        ? jump(report.jumps[0]) && jump(report.jumps[1]) && jump(report.jumps[2])
          && report.jumps[0].at < report.jumps[1].at && report.jumps[1].at < report.jumps[2].at
          && report.jumps[2].at - report.jumps[0].at <= 30 : false;
    }
    function invalidEvidence(report) {
      return fastEvidence(report) ? true : jumpEvidence(report);
    }
    function receiptPath(id) { return /databases/$(database)/documents/duel_reward_receipts/$(id); }
    function sealedCoverage(d, f) {
      return d.get('reward_protocol', 1) != 2 || (f.get('fix_count', 0) is int && f.get('fix_count', 0) >= 3
        && f.get('first_at', null) is timestamp && f.first_at >= d.started_at
        && f.first_at <= d.started_at + duration.value(30, 's')
        && f.get('observed_at', null) is timestamp && f.observed_at <= d.validating_at
        && f.observed_at >= d.validating_at - duration.value(15, 's')
        && f.observed_at >= f.first_at + duration.value(10, 's'));
    }
    // The detector latches at the third qualifying window/jump. Clean sealed
    // reports therefore contain fewer than that threshold, including zero.
    function cleanEvidence(report) {
      return report.get('windows', []) is list && report.get('windows', []).size() < 3
        && report.get('jumps', []) is list && report.get('jumps', []).size() < 3;
    }
    function cleanFinal(d, uid) {
      let f = d.get('finals', {}).get(uid, {});
      return f.get('invalid', true) == false && f.get('for', null) == d.validating_at && cleanEvidence(f);
    }
    function validatedDuel(d) {
      return d.get('protocol', 0) == 2 && d.status == 'done'
        && d.get('validated_at', null) is timestamp && cleanFinal(d, d.from) && cleanFinal(d, d.to);
    }
    function duelRunOk(uid, id, a) {
      let linked = a.get('mode', '') == 'duel' || a.get('duel_id', '') != '' || id.matches('duel_.*');
      return !linked || (a.get('duel_id', '') is string && a.get('duel_id', '') != ''
        && id == 'duel_' + a.duel_id && uid in get(challengePath(a.duel_id)).data.participants
        && validatedDuel(get(challengePath(a.duel_id)).data));
    }
    function duelUserGuard(uid) {
      return (!changed('last_duel_id') || validatedDuel(getAfter(challengePath(nd('last_duel_id', ''))).data))
        && (!runCommit() || duelRunOk(uid, nd('last_run_id', ''), getAfter(actPath(uid, nd('last_run_id', ''))).data));
    }
    function released(uid, id) {
      let old = get(activityPath(uid)).data;
      let next = getAfter(activityPath(uid)).data;
      return old.challenge_id != id || (next.kind == 'available' && next.challenge_id == id);
    }
    function releaseBoth(d, id) { return released(d.from, id) && released(d.to, id); }
    function progressOk(d, next, cutoff) {
      return ownKeyOnly('progress') && myProg(next) is number && myProg(next) >= myProg(d)
        && myProg(next) <= (cutoff.toMillis() - d.started_at.toMillis()) / 3600000.0
             * 25 + 0.2;
    }
    function opponentGone(d) {
      return request.time >= d.get('seen', {}).get(otherOf(d), d.started_at) + duration.value(90, 's');
    }
    function slotsStale(d) {
      return request.time >= get(activityPath(d.from)).data.updated_at + duration.value(150, 's')
        || request.time >= get(activityPath(d.to)).data.updated_at + duration.value(150, 's');
    }
    function expiredDuel(d) {
      return (d.status == 'pending' && !pendingLive(d)) || (d.status == 'lobby' && !roomLive(d))
        || (d.status == 'countdown' && request.time >= d.countdown_at + duration.value(150, 's'));
    }
    function nextKeys(allowed) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed); }
    function pendingChange(d, n, id) {
      return pendingLive(d) && (
        (request.auth.uid == d.to && !('delivered_at' in d) && n.status == 'pending'
          && nextKeys(['delivered_at', 'delivery_session']) && stamped(n, 'delivered_at')
          && n.delivery_session == get(activityPath(d.to)).data.session_id && duelReserved(d, id) && freshPlayers(d))
        || (request.auth.uid == d.to && n.status == 'lobby' && nextKeys(['status', 'accepted_at'])
          && stamped(n, 'accepted_at') && d.get('delivered_at', null) is timestamp
          && d.delivery_session == get(activityPath(d.to)).data.session_id && duelReserved(d, id) && freshPlayers(d))
        || (request.auth.uid == d.to && n.status == 'declined' && nextKeys(['status', 'finished_at'])
          && stamped(n, 'finished_at') && getAfter(cooldownPath(d.from, d.to)).data.challenge_id == id
          && getAfter(cooldownPath(d.from, d.to)).data.declined_at == request.time && releaseBoth(d, id))
        || (request.auth.uid == d.to && n.status == 'busy' && nextKeys(['status', 'finished_at'])
          && stamped(n, 'finished_at') && getAfter(activityPath(d.to)).data.kind == 'solo' && released(d.from, id))
        || (request.auth.uid == d.from && n.status == 'cancelled' && nextKeys(['status', 'finished_at'])
          && stamped(n, 'finished_at') && released(d.to, id)
          && getAfter(activityPath(d.from)).data.kind in ['available', 'solo'])
      );
    }
    function liveChange(d, n, id) {
      return (roomLive(d) && (
        (n.status == 'lobby' && nextKeys(['ready', 'seen']) && ownKeyOnly('ready') && ownKeyOnly('seen')
          && n.ready[request.auth.uid] is bool && n.seen[request.auth.uid] == request.time && duelReserved(d, id) && freshPlayers(d))
        || (n.status == 'countdown' && nextKeys(['status', 'countdown_at']) && stamped(n, 'countdown_at')
          && d.ready[d.from] == true && d.ready[d.to] == true && duelReserved(d, id) && freshPlayers(d))))
        || (d.status == 'countdown' && n.status == 'active' && nextKeys(['status', 'started_at']) && stamped(n, 'started_at')
          && request.time >= d.countdown_at + duration.value(5, 's')
          && request.time < d.countdown_at + duration.value(150, 's')
          && d.ready[d.from] == true && d.ready[d.to] == true && duelReserved(d, id) && freshPlayers(d))
        || (d.status in ['lobby', 'countdown'] && n.status == 'cancelled' && nextKeys(['status', 'finished_at'])
          && stamped(n, 'finished_at') && releaseBoth(d, id));
    }
    function activeChange(d, n) {
      return d.status == 'active' && (
        (n.status == 'active' && nextKeys(['progress', 'seen']) && ownKeyOnly('seen')
          && n.seen[request.auth.uid] == request.time && progressOk(d, n, request.time))
        || (n.status == 'validating' && stamped(n, 'validating_at') && (
          (nextKeys(['status', 'candidate', 'by_default', 'validating_at', 'progress', 'seen'])
            && n.candidate == request.auth.uid && n.by_default is bool && ownKeyOnly('seen')
            && n.seen[request.auth.uid] == request.time && progressOk(d, n, request.time)
            && (n.by_default == true ? opponentGone(d) : myProg(n) >= d.distance_km))
          || (nextKeys(['status', 'candidate', 'by_default', 'validating_at', 'forfeit_by'])
            && n.forfeit_by == request.auth.uid && n.candidate == otherOf(d) && n.by_default == true)
        ))) ;
    }
    function finalReportOk(d, n) {
      let uid = request.auth.uid;
      let report = n.get('finals', {}).get(uid, {});
      return nextKeys(['finals', 'progress']) && ownKeyOnly('finals') && !(uid in d.finals)
        && report.keys().hasOnly(['invalid', 'windows', 'jumps', 'observed_at', 'first_at', 'fix_count', 'for'])
        && report.get('invalid', true) == false && report.get('for', null) == d.validating_at
        && sealedCoverage(d, report) && cleanEvidence(report) && progressOk(d, n, d.validating_at);
    }
    function settlementOk(d, n, id) {
      let uid = request.auth.uid;
      return nextKeys(['status', 'winner', 'prize', 'finished_at', 'validated_at', 'reward_receipt'])
        && d.candidate == uid && n.winner == uid && cleanFinal(d, d.from) && cleanFinal(d, d.to)
        && n.reward_receipt == id && !exists(receiptPath(id))
        && getAfter(receiptPath(id)).data.winner == uid && getAfter(receiptPath(id)).data.prize == n.prize
        && stamped(n, 'finished_at') && stamped(n, 'validated_at') && n.prize is int && n.prize >= 0
        && n.prize <= d.reward && (d.by_default == true
          ? (myProg(d) < 0.2 ? n.prize == 0 : n.prize <= d.reward * (myProg(d) >= d.distance_km ? 1.0 : myProg(d) / d.distance_km))
          : myProg(d) >= d.distance_km)
        && (n.prize == 0 ? true : (getAfter(userDoc(uid)).data.last_duel_id == id
          && getAfter(userDoc(uid)).data.coins == get(userDoc(uid)).data.coins + n.prize));
    }
    function validatingChange(d, n, id) {
      return validationLive(d) && (n.status == 'validating' ? finalReportOk(d, n)
        : n.status == 'done' && settlementOk(d, n, id));
    }
    function invalidChange(d, n, id) {
      return d.status in ['active', 'validating'] && n.status == 'invalid'
        && !(request.auth.uid in d.finals) && nextKeys(['status', 'invalidated_by', 'invalid_reason', 'invalid_evidence', 'finished_at'])
        && n.invalidated_by == request.auth.uid && n.invalid_reason == 'unrealistic_movement'
        && n.invalid_evidence.get('invalid', false) == true && invalidEvidence(n.invalid_evidence)
        && n.invalid_evidence.observed_at is timestamp && n.invalid_evidence.observed_at >= d.started_at
        && n.invalid_evidence.observed_at <= (d.status == 'validating' ? d.validating_at : request.time)
        && stamped(n, 'finished_at') && releaseBoth(d, id);
    }
    function closeChange(d, n, id) {
      return nextKeys(['status', 'finished_at']) && stamped(n, 'finished_at') && releaseBoth(d, id) && (
        (n.status == 'expired' && expiredDuel(d))
        || (n.status == 'unverified' && (d.status == 'validating' || (d.status == 'active' && slotsStale(d))))
      );
    }
    function freeSlot(uid) {
      let s = get(activityPath(uid)).data;
      return s.kind == 'available' && s.updated_at <= request.time
        && request.time < s.updated_at + duration.value(150, 's');
    }
    function reservedAfter(uid, id) {
      let a = get(activityPath(uid)).data;
      let b = getAfter(activityPath(uid)).data;
      return b.kind == 'duel' && b.challenge_id == id && b.session_id == a.session_id && stamped(b, 'updated_at');
    }
    match /challenges/{cid} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['protocol', 'participants', 'from', 'to',
          'from_name', 'to_name', 'distance_km', 'reward', 'status', 'ready', 'progress', 'seen', 'finals', 'created_at', 'reward_protocol'])
        && request.resource.data.protocol == 2 && request.resource.data.reward_protocol == 2
        && request.resource.data.from == request.auth.uid
        && request.resource.data.participants == [request.auth.uid, request.resource.data.to]
        && request.resource.data.to is string && request.resource.data.to != request.auth.uid
        && request.resource.data.status == 'pending' && stamped(request.resource.data, 'created_at')
        && request.resource.data.from_name is string && request.resource.data.to_name is string
        && exists(/databases/$(database)/documents/users/$(request.auth.uid)/friends/$(request.resource.data.to))
        && request.resource.data.distance_km in [1, 3, 5, 10]
        && request.resource.data.reward == {'1': 200, '3': 400, '5': 600, '10': 1000}[string(request.resource.data.distance_km)]
        && request.resource.data.ready is map && request.resource.data.ready.keys().hasOnly(request.resource.data.participants)
        && request.resource.data.ready.size() == 2 && request.resource.data.ready[request.auth.uid] == false
        && request.resource.data.ready[request.resource.data.to] == false
        && request.resource.data.progress is map && request.resource.data.progress.keys().hasOnly(request.resource.data.participants)
        && request.resource.data.progress.size() == 2 && request.resource.data.progress[request.auth.uid] == 0
        && request.resource.data.progress[request.resource.data.to] == 0
        && request.resource.data.seen == {} && request.resource.data.finals == {}
        && freshPlayers(request.resource.data) && freeSlot(request.auth.uid) && freeSlot(request.resource.data.to)
        && reservedAfter(request.auth.uid, cid) && reservedAfter(request.resource.data.to, cid)
        && (!exists(cooldownPath(request.auth.uid, request.resource.data.to))
          || request.time >= get(cooldownPath(request.auth.uid, request.resource.data.to)).data.declined_at
              + duration.value(3600, 's'));
      allow update: if signedIn() && request.auth.uid in resource.data.participants && (
        (resource.data.get('protocol', 0) != 2 && resource.data.status in ['pending', 'lobby', 'countdown', 'active', 'forfeit']
          && request.resource.data.status == 'expired' && nextKeys(['status', 'finished_at']) && stamped(request.resource.data, 'finished_at'))
        || (resource.data.get('protocol', 0) == 2 && !terminal(resource.data)
          && (request.resource.data.status == 'invalid' ? invalidChange(resource.data, request.resource.data, cid)
            : request.resource.data.status in ['expired', 'unverified'] ? closeChange(resource.data, request.resource.data, cid)
            : resource.data.status == 'pending' ? pendingChange(resource.data, request.resource.data, cid)
            : resource.data.status in ['lobby', 'countdown'] ? liveChange(resource.data, request.resource.data, cid)
            : resource.data.status == 'active' ? activeChange(resource.data, request.resource.data)
            : validatingChange(resource.data, request.resource.data, cid)))
      );
      allow delete: if false;
    }
    function slotRelease(d, n, uid) {
      return d.kind == 'duel' && n.challenge_id == d.challenge_id && slotClosed(d, n, uid);
    }
    function slotClosed(d, n, uid) {
      let c = getAfter(challengePath(d.challenge_id)).data;
      return (
        (n.kind == 'available' && terminal(c))
        || (isMe(uid) && n.kind == 'solo' && c.status in ['busy', 'cancelled'])
      );
    }
    function slotReserve(d, n, uid) {
      return d.kind == 'available' && n.kind == 'duel' && n.session_id == d.session_id && slotInvited(n, uid);
    }
    function slotInvited(n, uid) {
      let c = getAfter(challengePath(n.challenge_id)).data;
      return !exists(challengePath(n.challenge_id)) && c.status == 'pending'
        && c.from == request.auth.uid && uid in c.participants;
    }
    match /player_activity/{uid} {
      allow read: if signedIn();
      allow create: if isMe(uid) && request.resource.data.keys().hasOnly(['kind', 'session_id', 'challenge_id', 'outcome_seen', 'updated_at'])
        && request.resource.data.kind == 'available' && request.resource.data.session_id is string
        && request.resource.data.challenge_id == '' && request.resource.data.outcome_seen == '' && stamped(request.resource.data, 'updated_at');
      allow update: if signedIn() && request.resource.data.keys().hasOnly(['kind', 'session_id', 'challenge_id', 'outcome_seen', 'updated_at'])
        && request.resource.data.session_id is string && request.resource.data.kind in ['available', 'solo', 'duel'] && (
          (isMe(uid) && nextKeys(['outcome_seen']) && request.resource.data.outcome_seen == resource.data.challenge_id
            && terminal(get(challengePath(resource.data.challenge_id)).data))
          || (stamped(request.resource.data, 'updated_at') && (
            (isMe(uid) && nextKeys(['updated_at']))
            || (isMe(uid) && resource.data.kind == 'available' && request.resource.data.kind in ['available', 'solo']
              && request.resource.data.challenge_id == resource.data.challenge_id && request.resource.data.outcome_seen == resource.data.outcome_seen)
            || ((isMe(uid) || nextKeys(['kind', 'updated_at'])) && slotRelease(resource.data, request.resource.data, uid))
            || slotReserve(resource.data, request.resource.data, uid)
            || (isMe(uid) && resource.data.kind == 'solo' && request.resource.data.kind == 'available'
              && (request.resource.data.session_id == resource.data.session_id
                  || request.time >= resource.data.updated_at + duration.value(150, 's'))
                && nextKeys(['kind', 'updated_at', 'session_id']))
          ))
        );
      allow delete: if isMe(uid) && resource.data.kind == 'available';
    }
    match /duel_reward_receipts/{id} {
      allow get: if signedIn() && request.auth.uid in get(challengePath(id)).data.participants;
      allow list: if false;
      allow create: if signedIn() && rewardReceiptOk(id);
      allow update, delete: if false;
    }
    function rewardReceiptOk(id) {
      let r = request.resource.data;
      let before = get(challengePath(id)).data;
      let after = getAfter(challengePath(id)).data;
      return r.keys().hasOnly(['challenge_id', 'participants', 'winner', 'prize', 'validated_at'])
        && r.challenge_id == id && r.participants == before.participants && r.winner == request.auth.uid
        && before.status == 'validating' && before.candidate == request.auth.uid && after.status == 'done'
        && after.winner == r.winner && after.prize == r.prize && after.reward_receipt == id
        && stamped(r, 'validated_at') && after.validated_at == request.time;
    }
    match /duel_cooldowns/{from}/recipients/{to} {
      allow get: if signedIn() && request.auth.uid in [from, to];
      allow create, update: if signedIn() && request.auth.uid == to
        && request.resource.data.keys().hasOnly(['challenge_id', 'declined_at']) && stamped(request.resource.data, 'declined_at')
        && get(challengePath(request.resource.data.challenge_id)).data.status == 'pending'
        && getAfter(challengePath(request.resource.data.challenge_id)).data.status == 'declined'
        && getAfter(challengePath(request.resource.data.challenge_id)).data.from == from
        && getAfter(challengePath(request.resource.data.challenge_id)).data.to == to;
      allow delete: if false;
    }

    // ── reports (write-only for players; review them in the Firebase console) ──
    match /reports/{rid} {
      allow create: if signedIn()
        && request.resource.data.reporter == request.auth.uid
        && request.resource.data.reported != request.auth.uid;
      allow read, update, delete: if false;
    }

    // ── private chat: doc id = "{smallerUid}_{largerUid}", friends only ──
    function chatOther(chatId) {
      return chatId.split('_')[0] == request.auth.uid
        ? chatId.split('_')[1]
        : chatId.split('_')[0];
    }
    function areFriends(chatId) {
      return request.auth.uid in chatId.split('_')
        && chatOther(chatId) != request.auth.uid
        && exists(/databases/$(database)/documents/users/$(request.auth.uid)/friends/$(chatOther(chatId)));
    }

    match /chats/{chatId} {
      allow get: if signedIn() && request.auth.uid in chatId.split('_')
        && request.auth.uid in resource.data.members;
      // A members/array-contains query cannot prove a document-ID expression.
      // Creation/update still validates members against the two ID owners.
      allow list: if signedIn() && request.auth.uid in resource.data.members;
      allow create, update: if signedIn()
        && request.resource.data.members.hasOnly(chatId.split('_'))
        && request.resource.data.members.size() == 2
        && areFriends(chatId);
      allow delete: if false;

      match /messages/{mid} {
        allow read: if signedIn() && areFriends(chatId);
        allow create: if signedIn()
          && areFriends(chatId)
          && request.resource.data.from == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 300;
        allow update, delete: if false;
      }
    }

  }
}
